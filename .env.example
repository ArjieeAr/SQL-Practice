# Copy to .env.local and fill in. Never commit .env.local.
# Find these in the Supabase dashboard under Project Settings -> API Keys.

# Public: safe to ship to the browser. All access is still governed by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...). A legacy "anon" key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: bypasses RLS. Used by the grader and the seed script, never imported
# into client code. The secret key (sb_secret_...). A legacy "service_role" key also works.
SUPABASE_SECRET_KEY=

# Base URL of the app, used to build OAuth / email-confirmation redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a throwaway account for the signed-in Playwright test (npm run e2e:user creates it).
# Use a test-only address and password, never a real account's.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=
